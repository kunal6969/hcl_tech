# .env.example — copy to .env and fill in real values
# Never commit .env to git

# --- LLM Providers ---
# Primary: Groq (https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL=openai/gpt-oss-20b

# Fallback: Google Gemini (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# --- Testing / Offline mode ---
# Set MOCK_LLM=true to run the full pipeline without any LLM API calls
# All tests must pass with MOCK_LLM=true
MOCK_LLM=false

# --- Embedding model ---
# Set EMBEDDINGS=hash to use hash-based embeddings (offline, for tests only)
# Leave blank or set to "sentence_transformer" to use MiniLM
EMBEDDINGS=

# --- Data paths (defaults are relative to project root) ---
# DATA_DIR=./data

# LLM disclosure (as required by REQUIREMENTS.md D2):
# Primary provider: Groq (llama-3.3-70b-versatile)
# Fallback provider: Google Gemini Flash (gemini-1.5-flash)
# Test mode: MOCK_LLM=true (canned deterministic responses, no API calls)
